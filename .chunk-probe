<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mikail Odabas - Professional CV</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Language Switcher -->
    <div class="language-switcher">
        <button class="lang-btn active" data-lang="en">
            <span class="flag-icon">🇬🇧</span>
            <span class="lang-text">EN</span>
        </button>
        <button class="lang-btn" data-lang="nl">
            <span class="flag-icon">🇳🇱</span>
            <span class="lang-text">NL</span>
        </button>
    </div>

    <!-- Profile Switcher -->
    <div class="profile-switcher">
        <button class="profile-toggle" id="profileToggle">
            <i class="fas fa-user-tie"></i>
            <span class="profile-toggle-text">CV Version</span>
            <i class="fas fa-chevron-down profile-chevron"></i>
        </button>
        <div class="profile-dropdown" id="profileDropdown">
            <button class="profile-btn active" data-profile="general">
                <i class="fas fa-user"></i>
                <div class="profile-btn-content">
                    <span class="profile-name">General</span>
                    <span class="profile-desc">Full CV overview</span>
                </div>
            </button>
            <button class="profile-btn" data-profile="tech">
                <i class="fas fa-laptop-code"></i>
                <div class="profile-btn-content">
                    <span class="profile-name">Tech & IT</span>
                    <span class="profile-desc">Development & AI focus</span>
                </div>
            </button>
            <button class="profile-btn" data-profile="sales">
                <i class="fas fa-chart-line"></i>
                <div class="profile-btn-content">
                    <span class="profile-name">Sales & Business</span>
                    <span class="profile-desc">Commercial & account mgmt</span>
                </div>
            </button>
            <button class="profile-btn" data-profile="government">
                <i class="fas fa-landmark"></i>
                <div class="profile-btn-content">
                    <span class="profile-name">Government</span>
                    <span class="profile-desc">Public sector & policy</span>
                </div>
            </button>
            <button class="profile-btn" data-profile="creative">
